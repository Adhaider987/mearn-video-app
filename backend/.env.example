# Comma-separated browser origins allowed for CORS + Socket.IO (must match the URL bar of your React app).
# Local Vite defaults:
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When the frontend is served through ngrok (or another HTTPS tunnel), add that exact origin too, e.g.:
# CLIENT_ORIGINS=http://localhost:5173,https://your-frontend-subdomain.ngrok-free.dev
#
# If you use ONE ngrok URL to Vite only, browsers talk to Socket.IO on that same https origin and Vite
# proxies to this server — you still must allow the ngrok origin in CLIENT_ORIGINS for any direct API calls.

PORT=5000
