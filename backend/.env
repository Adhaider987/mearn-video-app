# Comma-separated browser origins allowed for CORS + Socket.IO (must match the URL bar of your React app).
# Local Vite defaults:
# CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When the frontend is served through ngrok (or another HTTPS tunnel), add that exact origin too, e.g.:
CLIENT_ORIGINS=https://overnervously-nidicolous-madlyn.ngrok-free.dev,http://localhost:5173,http://127.0.0.1:5173

# Optional: second tunnel for this API — set VITE_SOCKET_URL on the frontend to the same public URL.
# Typical setup: tunnel A -> Vite :5173, tunnel B -> Node :5000 (two ngrok processes).

PORT=5000
MONGODB_URI=mongodb://localhost:27017/video-call-app
JWT_SECRET=your_super_secret_jwt_key_12345
NODE_ENV=development
