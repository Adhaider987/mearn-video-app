# Leave UNSET (or delete this line) when you tunnel only the Vite dev server (e.g. one ngrok URL).
# The app will connect Socket.IO to the same origin as the page; Vite proxies /socket.io → Express :5000.
#
# Only set this if you run a *second* public URL for the API, e.g. a separate ngrok tunnel to port 5000:
# VITE_SOCKET_URL=https://your-api-subdomain.ngrok-free.dev

# Optional: extra ICE servers (JSON array), merged with the built-in Google STUN server.
# Often required for two phones / strict NATs so WebRTC can connect (not just signaling):
# VITE_ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
